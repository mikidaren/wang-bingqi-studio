---
import { finite, getMetricProgress, isValidMetric, metricLabel, metricDisplayValue } from '../lib/resource-metrics.mjs';
type MetricKind = 'cpu' | 'memory' | 'storage' | 'gpu' | 'quota' | 'runtime' | 'network' | 'concurrency' | 'requests';
interface ResourceMetricData {
  key: string;
  label: string;
  kind: MetricKind;
  mode: 'capacity' | 'usage' | 'balance' | 'unknown';
  displayValue: string;
  unit?: string;
  value?: number;
  used?: number;
  limit?: number;
  remaining?: number;
  percent?: number;
  quotaState?: 'exhausted';
  referenceLabel?: string;
  periodLabel?: string;
  basis: 'recorded-config' | 'plan-limit' | 'observed' | 'user-confirmed' | 'unknown';
  checkedAt?: string;
  note?: string;
}
interface Props {
  metric: ResourceMetricData;
  resourceId: string;
  usageStatus?: 'observed' | 'stale' | 'unknown';
}
const { metric, resourceId, usageStatus } = Astro.props;
const visible = isValidMetric(metric);
const progress = getMetricProgress(metric);
const isCores = metric.kind === 'cpu' && metric.mode === 'capacity' && /^(v?cpu|cores?|核)$/i.test(metric.unit || '');
const cores = isCores && finite(metric.value) && Number.isInteger(metric.value) ? metric.value! : 0;
const gpus = metric.kind === 'gpu' && metric.mode === 'capacity' && finite(metric.value) && Number.isInteger(metric.value) ? metric.value! : 0;
const icon = ({ cpu: 'cpu', memory: 'memory', storage: 'database', gpu: 'gpu', quota: 'spark', runtime: 'clock', network: 'globe', concurrency: 'box', requests: 'code' })[metric.kind];
const label = metricLabel(metric);
const displayValue = metricDisplayValue(metric);
const titleId = `${resourceId}-metric-${metric.key}`;
const basis = metric.basis === 'recorded-config' ? '配置记录' : metric.basis === 'plan-limit' ? '方案额度'
  : metric.basis === 'user-confirmed' ? '用户确认' : usageStatus === 'stale' ? '历史读数' : '账户读数';
const description = [label, displayValue, basis, progress?.valueText, metric.periodLabel,
  metric.checkedAt && `${metric.basis === 'user-confirmed' ? '确认' : '查询'}时间 ${metric.checkedAt}`,
].filter(Boolean).join('；');
---
{visible && (
  <div class:list={['cloud-metric', `cloud-metric--${metric.kind}`, `cloud-metric--${metric.mode}`, { 'cloud-metric--progress': Boolean(progress) }]}
    data-metric-key={metric.key} data-metric-mode={metric.mode} data-metric-kind={metric.kind} data-metric-basis={metric.basis}
    data-metric-checked-at={metric.checkedAt} data-metric-percent={progress ? String(progress.percent) : undefined}
    data-progress-tone={progress?.tone} data-quota-state={metric.quotaState} role="group" aria-labelledby={titleId} title={description}>
    <div class="cloud-metric-top">
      <span class="cloud-metric-label" id={titleId}><svg class="cloud-icon" aria-hidden="true"><use href={`#cloud-icon-${icon}`} /></svg>{label}</span>
      <strong class:list={['cloud-metric-value', { 'cloud-metric-value--compact': displayValue.length > 20 }]}>{displayValue}</strong>
    </div>
    {progress ? (
      <div class="cloud-metric-visual">
        <div class="cloud-usage-bar" role="meter" aria-label={label} aria-valuemin="0" aria-valuemax="100"
          aria-valuenow={progress.fill} aria-valuetext={progress.valueText}><span style={`width:${progress.fill}%`} /></div>
        <div class="cloud-usage-scale"><span>{progress.left}</span><span>{progress.right}</span></div>
      </div>
    ) : cores > 0 ? (
      <div class="cloud-metric-visual cloud-core-bars" role="img" aria-label={`${cores} 个 CPU 核心；${basis}`}>
        {Array.from({ length: Math.min(16, cores) }, () => <i aria-hidden="true" />)}
        {cores > 16 && <span>+{cores - 16}</span>}
      </div>
    ) : gpus > 0 ? (
      <div class="cloud-metric-visual cloud-gpu-tags" role="img" aria-label={description}>
        {Array.from({ length: Math.min(4, gpus) }, () => <span aria-hidden="true">{/\bT4\b/.test(metric.displayValue) ? 'T4' : 'GPU'}</span>)}
        {gpus > 4 && <span>+{gpus - 4}</span>}
      </div>
    ) : metric.mode === 'usage' ? (
      <div class="cloud-usage-scale"><span>已用</span>{metric.periodLabel && <span>{metric.periodLabel}</span>}</div>
    ) : null}
    {progress && metric.periodLabel && <span class="cloud-metric-period">{metric.periodLabel}</span>}
  </div>
)}
