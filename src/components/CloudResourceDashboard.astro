---
import '../styles/cloud-resources.css';
import ResourceMetric from './ResourceMetric.astro';

interface ResourceMetricData {
  key: string;
  label: string;
  kind: 'cpu' | 'memory' | 'storage' | 'gpu' | 'quota' | 'runtime' | 'network' | 'concurrency' | 'requests';
  mode: 'capacity' | 'usage' | 'balance' | 'unknown';
  displayValue: string;
  unit?: string;
  value?: number;
  used?: number;
  limit?: number;
  remaining?: number;
  percent?: number;
  basis: 'recorded-config' | 'plan-limit' | 'observed' | 'unknown';
  checkedAt?: string;
  note?: string;
}
interface Resource {
  id: string;
  provider: string;
  name: string;
  category: string;
  claimStatus: 'claimed' | 'registered';
  initials: string;
  accent: string;
  configuration: { label: string; value: string }[];
  recordedAt: string;
  availability: string;
  officialUrl: string;
  consoleUrl?: string;
  consoleLabel?: string;
  metrics?: ResourceMetricData[];
  usageStatus?: 'observed' | 'stale' | 'unknown';
}
interface Props {
  dashboard: {
    updatedAt: string;
    categories: { id: string; label: string }[];
    resources: Resource[];
  };
  showPosts?: boolean;
}
const { dashboard, showPosts = false } = Astro.props;
const finite = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value) && value >= 0;
const visibleMetric = (metric: ResourceMetricData, resource: Resource) => {
  if (metric.mode === 'unknown' || metric.basis === 'unknown' || !metric.displayValue?.trim()) return false;
  if (['value', 'used', 'limit', 'remaining', 'percent'].some(key => {
    const value = metric[key as 'value' | 'used' | 'limit' | 'remaining' | 'percent'];
    return value !== undefined && !finite(value);
  })) return false;
  if (metric.mode === 'capacity') return (finite(metric.value) && metric.value >= 0)
    || (resource.id === 'colab-free' && metric.kind === 'gpu' && metric.value === undefined);
  if (metric.mode === 'balance') return finite(metric.remaining);
  if (metric.mode === 'usage') return finite(metric.used);
  return false;
};
const resourceMetrics = (resource: Resource): ResourceMetricData[] => {
  const metrics = [...(resource.metrics || [])];
  const gpuMemory = resource.configuration.find(item => item.label.includes('显存') && item.value === '16 GB / 张');
  if (resource.id === 'kaggle-gpu' && gpuMemory && !metrics.some(metric => metric.key === 'gpu_memory')) {
    metrics.push({ key: 'gpu_memory', label: '单卡显存', kind: 'memory', mode: 'capacity', displayValue: gpuMemory.value, value: 16, unit: 'GB / GPU', basis: 'recorded-config' });
  }
  const shellHours = resource.configuration.find(item => item.label === '方案时长' && item.value === '50 小时 / 周');
  if (resource.id === 'google-cloud-shell' && shellHours && !metrics.some(metric => metric.key === 'weekly_hours')) {
    metrics.push({ key: 'weekly_hours', label: '每周时长', kind: 'runtime', mode: 'capacity', displayValue: shellHours.value, value: 50, unit: 'hours / week', basis: 'plan-limit' });
  }
  return metrics.filter(metric => visibleMetric(metric, resource));
};
const featured = ['instabox-free', 'kaggle-gpu', 'colab-free', 'google-cloud-shell'];
const order = (id: string) => featured.includes(id) ? featured.indexOf(id) : featured.length;
const resources = dashboard.resources
  .filter(resource => resource.claimStatus === 'claimed' && !['historical', 'restricted'].includes(resource.availability))
  .map(resource => ({ ...resource, metrics: resourceMetrics(resource) }))
  .filter(resource => resource.metrics.length > 0)
  .sort((a, b) => order(a.id) - order(b.id));
const categories = dashboard.categories.filter(category => resources.some(resource => resource.category === category.id));
const countForCategory = (category: string) => resources.filter(resource => resource.category === category).length;
const purposes: Record<string, string> = {
  'instabox-free': '云开发环境', 'kaggle-gpu': 'GPU 笔记本', 'colab-free': '按会话分配的 AI 笔记本',
  'google-cloud-shell': '云端开发终端', 'cloudflare-workers': '边缘函数', 'cloudflare-pages': '静态网站托管',
  'cloudflare-kv': '键值存储', 'cloudflare-r2-webdav': '对象存储', 'cloudflare-browser-run': '云端浏览器',
  'browserless-free': '浏览器自动化', 'cloudflare-d1': 'SQL 数据库', 'firecrawl-free': '网页采集',
};
const searchText = (resource: Resource & { metrics: ResourceMetricData[] }) => [
  resource.name, resource.provider, purposes[resource.id] || '',
  ...resource.metrics.flatMap(metric => [metric.mode === 'balance' ? '剩余额度' : metric.key === 'plan_credits' ? '账期额度' : metric.label, metric.displayValue]),
].join(' ').normalize('NFKC').toLocaleLowerCase();
const displayDate = (date: string) => date.slice(0, 10).replaceAll('-', '.');
const observationTime = (date: string) => new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false,
}).format(new Date(date)).replaceAll('/', '.');
const recordedTime = (resource: Resource & { metrics: ResourceMetricData[] }) => {
  const observed = resource.metrics.find(metric => metric.basis === 'observed' && metric.checkedAt)?.checkedAt;
  return observed ? { value: observed, label: observationTime(observed), title: '北京时间' }
    : { value: resource.recordedAt, label: displayDate(resource.recordedAt), title: undefined };
};
---

<div class="cloud-dashboard" data-cloud-dashboard>
  <svg class="cloud-icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <symbol id="cloud-icon-arrow-left" viewBox="0 0 24 24"><path d="m12 5-7 7 7 7M5 12h14" /></symbol>
      <symbol id="cloud-icon-arrow-up-right" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></symbol>
      <symbol id="cloud-icon-search" viewBox="0 0 24 24"><circle cx="10.75" cy="10.75" r="6.75" /><path d="m16 16 4.5 4.5" /></symbol>
      <symbol id="cloud-icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></symbol>
      <symbol id="cloud-icon-reset" viewBox="0 0 24 24"><path d="M3 10a9 9 0 1 1 1.7 7M3 4v6h6" /></symbol>
      <symbol id="cloud-icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
      <symbol id="cloud-icon-check-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" /></symbol>
      <symbol id="cloud-icon-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 10v6M12 7h.01" /></symbol>
      <symbol id="cloud-icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
      <symbol id="cloud-icon-cpu" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="3" /><path d="M9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3" /><rect x="9" y="9" width="6" height="6" rx="1" /></symbol>
      <symbol id="cloud-icon-memory" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="11" rx="2" /><path d="M7 10v3m5-3v3m5-3v3M6 17v3m4-3v3m4-3v3m4-3v3" /></symbol>
      <symbol id="cloud-icon-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3" /><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7" /></symbol>
      <symbol id="cloud-icon-gpu" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="2" /><circle cx="11" cy="11.5" r="3.5" /><path d="M3 9H1m0 8h2m4 1v3m10-3v3m1-12h1m-1 4h1" /></symbol>
      <symbol id="cloud-icon-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></symbol>
      <symbol id="cloud-icon-code" viewBox="0 0 24 24"><path d="m7 6-5 6 5 6m10-12 5 6-5 6m-4-15-2 18" /></symbol>
      <symbol id="cloud-icon-spark" viewBox="0 0 24 24"><path d="m12 3 2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3Z" /></symbol>
      <symbol id="cloud-icon-box" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5ZM3 8v9l9 5 9-5V8M12 13v9M7.5 5.5l9 5" /></symbol>
      <symbol id="cloud-icon-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" /></symbol>
      <symbol id="cloud-icon-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z" /><path d="M3 11h18" /></symbol>
    </defs>
  </svg>
  <div class="cloud-shell">
    <header class="cloud-topbar">
      <a class="cloud-brand" href="https://miki2022.eu.org/">WANG BINGQI</a>
      <nav class="cloud-site-nav" aria-label="网站导航">
        <a href="/">Studio</a>
        <a href="/category/process" aria-current="page">Process</a>
      </nav>
    </header>

    <main class="cloud-main" id="cloud-resources">
      <div class="cloud-page-heading">
        <h1>云资源 <span class="cloud-result-count" data-result-count role="status" aria-live="polite" aria-atomic="true" aria-label={`${resources.length} 项资源`}>{resources.length}</span></h1>
      </div>

      <section class="cloud-resource-section" aria-label="资源清单">
        <div class="cloud-category-list" role="group" aria-label="按资源类别筛选">
          <button type="button" class="cloud-category-button" data-category-filter="all" data-category-label="全部" aria-pressed="true" disabled><span>全部</span><span class="cloud-category-count" data-category-count>{resources.length}</span></button>
          {categories.map(category => <button type="button" class="cloud-category-button" data-category-filter={category.id} data-category-label={category.label} aria-pressed="false" disabled><span>{category.label}</span><span class="cloud-category-count" data-category-count>{countForCategory(category.id)}</span></button>)}
        </div>
        <div class="cloud-toolbar">
          <div class="cloud-search">
            <svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-search" /></svg>
            <input type="search" name="resource-search" aria-label="搜索资源名称或配置" placeholder="搜索资源、配置…" autocomplete="off" spellcheck="false" data-search-input disabled />
            <button type="button" class="cloud-clear-search" data-clear-search aria-label="清除搜索" hidden><svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-close" /></svg></button>
          </div>
          <button type="button" class="cloud-reset-button" data-reset-filters hidden><svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-reset" /></svg>重置</button>
        </div>

        <div class="cloud-resource-grid" data-resource-grid>
          {resources.map(resource => {
            const time = recordedTime(resource);
            const linkLabel = resource.consoleUrl ? (resource.consoleLabel || '打开控制台') : '查看说明';
            return <article class="cloud-resource-card" data-resource-card data-category={resource.category} data-search={searchText(resource)} style={`--resource-accent: ${resource.id === 'instabox-free' ? '#ee690b' : resource.accent}`} aria-labelledby={`resource-title-${resource.id}`}>
              <div class="cloud-card-main">
                <div class="cloud-card-header">
                  <div class="cloud-provider-icon" aria-hidden="true">{resource.id === 'instabox-free' ? 'I' : resource.initials}</div>
                  <div class="cloud-card-identity">
                    <div class="cloud-card-title-row"><h2 id={`resource-title-${resource.id}`}>{resource.name}</h2><span class="cloud-claim-badge"><svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-check" /></svg>已领取</span></div>
                    <div class="cloud-provider-meta"><span class="cloud-provider-name">{resource.provider}</span>{purposes[resource.id] && <span class="cloud-card-purpose">{purposes[resource.id]}</span>}</div>
                  </div>
                </div>
                <div class="cloud-metric-grid">{resource.metrics.map(metric => <ResourceMetric metric={metric} resourceId={resource.id} usageStatus={resource.usageStatus} />)}</div>
                {resource.id === 'cloudflare-r2-webdav' && <p class="cloud-card-footnote">超出包含额度可能计费</p>}
              </div>
              <div class="cloud-card-footer"><span class="cloud-record-date">记录于 <time datetime={time.value} title={time.title}>{time.label}</time></span><a class="cloud-console-link" href={resource.consoleUrl || resource.officialUrl} target="_blank" rel="noopener noreferrer" aria-label={`${resource.name}：${linkLabel}（新标签页）`}>{linkLabel}<svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-arrow-up-right" /></svg></a></div>
            </article>;
          })}
        </div>
        <div class="cloud-empty-state" data-empty-state hidden><svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-search" /></svg><h2>没有匹配的资源</h2><button type="button" class="cloud-empty-reset" data-reset-filters>重置筛选</button></div>
      </section>
      {showPosts && Astro.slots.has('posts') && <section class="cloud-posts"><slot name="posts" /></section>}
    </main>

    <footer class="cloud-page-footer"><p>{resources.length} 项资源<span aria-hidden="true">·</span>{categories.length} 类</p><a href="/">Studio<svg class="cloud-icon" aria-hidden="true"><use href="#cloud-icon-arrow-up-right" /></svg></a></footer>
  </div>
</div>

<script>
  function initializeCloudDashboard() {
    const root = document.querySelector<HTMLElement>('[data-cloud-dashboard]');
    if (!root || root.dataset.cloudReady === 'true') return;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-resource-card]'));
    const categoryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const clearSearch = root.querySelector<HTMLButtonElement>('[data-clear-search]');
    const resetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-reset-filters]'));
    const resultCount = root.querySelector<HTMLElement>('[data-result-count]');
    const emptyState = root.querySelector<HTMLElement>('[data-empty-state]');
    if (!searchInput || !clearSearch || !resultCount || !emptyState) return;
    let category = 'all';
    function updateResults() {
      if (!searchInput || !clearSearch || !resultCount || !emptyState) return;
      const query = searchInput.value.normalize('NFKC').trim().toLocaleLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      let visibleCount = 0;
      cards.forEach(card => {
        const visible = (category === 'all' || card.dataset.category === category)
          && terms.every(term => (card.dataset.search || '').includes(term));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      categoryButtons.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === category));
      });
      resultCount.textContent = String(visibleCount);
      resultCount.setAttribute('aria-label', `${visibleCount} 项资源`);
      emptyState.hidden = visibleCount !== 0;
      clearSearch.hidden = searchInput.value.length === 0;
      resetButtons.forEach(button => {
        if (!button.closest('[data-empty-state]')) button.hidden = category === 'all' && query.length === 0;
      });
    }
    categoryButtons.forEach(button => {
      button.disabled = false;
      button.addEventListener('click', () => {
        category = button.dataset.categoryFilter || 'all';
        updateResults();
      });
    });
    searchInput.disabled = false;
    searchInput.addEventListener('input', updateResults);
    searchInput.addEventListener('keydown', event => {
      if (event.key === 'Escape' && searchInput.value) {
        searchInput.value = '';
        updateResults();
      }
    });
    clearSearch.addEventListener('click', () => {
      searchInput.value = '';
      updateResults();
      searchInput.focus();
    });
    resetButtons.forEach(button => button.addEventListener('click', () => {
      category = 'all';
      searchInput.value = '';
      updateResults();
      searchInput.focus();
    }));
    root.dataset.cloudReady = 'true';
    updateResults();
  }
  initializeCloudDashboard();
  document.addEventListener('astro:page-load', initializeCloudDashboard);
</script>
