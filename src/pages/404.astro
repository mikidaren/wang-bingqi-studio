---
import Base from '../layouts/Base.astro';
import { studioProjects } from '../data/studio-projects';
---

<Base title="页面未找到" description="这个地址没有对应的页面。返回 Studio 或进入现有项目。" robots="noindex">
  <section class="studio-not-found">
    <span class="studio-error-code">404</span>
    <h1>页面未找到</h1>
    <p>这个地址没有对应的页面。</p>
    <a class="studio-home-button" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 5-7 7 7 7M5 12h14" /></svg>回到 Studio</a>
    <div class="studio-recovery-links" aria-label="现有入口">{studioProjects.map(project => <a href={project.href}>{project.title}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>)}</div>
  </section>
</Base>
