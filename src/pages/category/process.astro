---
import CloudResourceDashboard from '../../components/CloudResourceDashboard.astro';
import catalog from '../../data/cloud-resources.json';
import snapshot from '../../data/resource-usage-snapshot.json';

const dashboard = { ...catalog, resources: catalog.resources.map(resource => {
  const update = snapshot.resources.find(item => item.id === resource.id);
  if (!update) return resource;
  const metrics = new Map((resource.metrics || []).map(metric => [metric.key, metric]));
  for (const metric of update.metrics) metrics.set(metric.key, metric);
  return { ...resource, metrics: [...metrics.values()] };
}) };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="我的云资源：已领取资源的配置、额度与控制台入口。" />
    <meta name="theme-color" content="#000000" />
    <title>云资源 — WANG Bingqi Studio</title>
    <link rel="canonical" href="https://studio.miki2022.eu.org/category/process/" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body class="cloud-resources-page">
    <CloudResourceDashboard dashboard={dashboard} />
  </body>
</html>
