---
import '../styles/global.css';
import { studioProjects } from '../data/studio-projects';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description = 'WANG BINGQI Studio — 项目与工具', robots } = Astro.props;
const fullTitle = title === 'Studio' ? 'Studio — WANG BINGQI' : `${title} — WANG BINGQI Studio`;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const path = href.replace(/\/+$/, '') || '/';
  return pathname === path || (path !== '/' && pathname.startsWith(`${path}/`));
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {robots && <meta name="robots" content={robots} />}
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body class="studio-page">
    <a class="studio-skip-link" href="#main-content">跳至内容</a>
    <header class="studio-site-header">
      <div class="studio-container studio-header-inner">
        <a href="/" class="studio-wordmark" aria-label="WANG BINGQI Studio 首页">WANG BINGQI</a>
        <nav class="studio-site-nav" aria-label="Studio 入口">
          {studioProjects.map(project => <a href={project.href} aria-current={isCurrent(project.href) ? 'page' : undefined}>{project.title}</a>)}
        </nav>
      </div>
    </header>
    <main id="main-content" class="studio-site-main"><div class="studio-container"><slot /></div></main>
    <footer class="studio-site-footer">
      <div class="studio-container studio-footer-inner">
        <p>© {new Date().getFullYear()} WANG BINGQI <span aria-hidden="true">/</span> Studio</p>
        <a href="https://miki2022.eu.org/" target="_blank" rel="noopener noreferrer" aria-label="打开主站（新标签页）">主站<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
      </div>
    </footer>
  </body>
</html>
